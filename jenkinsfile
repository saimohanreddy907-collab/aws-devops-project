pipeline {
    agent any

    stages {
        stage('Download Code') {
            steps {
                echo 'Getting code from GitHub'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t aws-devops-app .'
            }
        }

        stage('Deploy Application') {
            steps {
                sh 'docker rm -f my-web-app || true'
                sh 'docker run -d -p 5000:5000 --name my-web-app aws-devops-app'
            }
        }

        stage('Test Application') {
            steps {
                sh 'curl -f http://localhost:5000'
            }
        }
    }
}
